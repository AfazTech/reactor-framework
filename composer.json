{
    "name": "afaztech/reactor-framework",
    "description": "A modern, asynchronous PHP framework for building powerful Telegram bots.",
    "type": "framework",
    "license": "MIT",
    "keywords": [
        "telegram",
        "telegram bot",
        "telegram api",
        "bot framework",
        "reactor",
        "async",
        "php",
        "dependency injection",
        "middleware",
        "migrations",
        "scheduler"
    ],
    "homepage": "https://github.com/afaztech/reactor-framework",
    "authors": [
        {
            "name": "Abolfazl Majidi (Afaz)",
            "email": "contact@afaz.me",
            "homepage": "https://afaz.me"
        }
    ],
    "support": {
        "issues": "https://github.com/afaztech/reactor-framework/issues",
        "source": "https://github.com/afaztech/reactor-framework"
    },
    "require": {
        "php": ">=8.4",
        "amphp/amp": "^3.0",
        "amphp/redis": "^2.0",
        "amphp/mysql": "^3.0",
        "amphp/postgres": "^2.0",
        "amphp/file": "^4.0",
        "amphp/sync": "^2.0",
        "fabpot/amphp-sqlite3": "dev-main",
        "illuminate/database": "^9.0",
        "illuminate/events": "^9.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "symfony/console": "^6.0",
        "afaztech/neili": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Reactor\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
